{
  "name": "wasl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "vitest run --project unit --passWithNoTests",
    "test:int": "vitest run --project integration",
    "vapid": "tsx scripts/gen-vapid.ts",
    "smoke": "bash scripts/smoke.sh",
    "e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "create-platform-admin": "tsx scripts/create-platform-admin.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.2",
    "html5-qrcode": "^2.3.8",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "web-push": "^4.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.7.0",
    "dotenv": "^18.0.10",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
