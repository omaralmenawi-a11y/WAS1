DATABASE_URL=postgresql://user:password@localhost:5432/wasl_dev
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/wasl_test
# Signs the rotating pickup codes. Production refuses to start unless it is >= 32 chars and not the placeholder.
PICKUP_CODE_SECRET=change-me-32-bytes-minimum
# dev = codes are logged, not sent. Production refuses OTP_MODE=dev unless ALLOW_DEV_OTP_IN_PRODUCTION=1 (demo only).
OTP_MODE=dev
APP_URL=http://localhost:3000
# Optional: use a pre-installed Chromium for e2e instead of `npx playwright install chromium`
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium
